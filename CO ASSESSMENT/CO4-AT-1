#define MAX 100

void sort(int a[], int n)
{
    int i, j, temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (a[j] > a[j + 1])
            {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
}

void cscan(int request[], int n, int head, int diskSize, int direction)
{
    int a[MAX];
    int i, total = 0, current = head;

    for (i = 0; i < n; i++)
        a[i] = request[i];

    sort(a, n);

    printf("\nC-SCAN Seek Sequence: %d ", head);

    if (direction == 1)
    {
        /* Move right */
        for (i = 0; i < n; i++)
        {
            if (a[i] >= head)
            {
                total += abs(current - a[i]);
                current = a[i];
                printf("-> %d ", current);
            }
        }

        total += (diskSize - 1) - current;
        current = diskSize - 1;
        printf("-> %d ", current);

        /* Jump to beginning */
        total += diskSize - 1;
        current = 0;
        printf("-> %d ", current);

        for (i = 0; i < n; i++)
        {
            if (a[i] < head)
            {
                total += abs(current - a[i]);
                current = a[i];
                printf("-> %d ", current);
            }
        }
    }
    else
    {
        /* Move left */
        for (i = n - 1; i >= 0; i--)
        {
            if (a[i] <= head)
            {
                total += abs(current - a[i]);
                current = a[i];
                printf("-> %d ", current);
            }
        }

        total += current;
        current = 0;
        printf("-> %d ", current);

