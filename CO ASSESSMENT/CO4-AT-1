#include <stdio.h>
#include <stdlib.h>

#define MAX 100

int allocateContiguous(int disk[], int n, int size, int allocated[])
{
    int i, j, count;

    for (i = 0; i <= n - size; i++)
    {
        count = 0;

        for (j = i; j < i + size; j++)
        {
            if (disk[j] == 0)
                count++;
            else
                break;
        }

        if (count == size)
        {
            for (j = 0; j < size; j++)
            {
                disk[i + j] = 1;
                allocated[j] = i + j;
            }

            return size;
        }
    }

    return 0;
}

int allocateIndexed(int disk[], int n, int size, int allocated[])
{
    int i, count = 0;
    int indexBlock = -1;

    for (i = 0; i < n; i++)
    {
        if (disk[i] == 0)
        {
            indexBlock = i;
            disk[i] = 1;
            break;
        }
    }

    if (indexBlock == -1)
        return 0;

    for (i = 0; i < n && count < size; i++)
    {
        if (disk[i] == 0)
        {
            disk[i] = 1;
            allocated[count] = i;
            count++;
        }
    }

    if (count < size)
        return 0;

    printf("Index block: %d\n", indexBlock);

    return count;
}

