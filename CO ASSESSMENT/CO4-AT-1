#include <stdio.h>

#define MAX 100

void contiguous(int disk[], int n, int fileSize)
{
    int i, j, start = -1, count;

    for (i = 0; i <= n - fileSize; i++)
    {
        count = 0;

        for (j = i; j < i + fileSize; j++)
        {
            if (disk[j] == 0)
                count++;
            else
                break;
        }

        if (count == fileSize)
        {
            start = i;
            break;
        }
    }

    if (start == -1)
    {
        printf("Contiguous allocation failed.\n");
        printf("Insufficient continuous free space.\n");
    }
    else
    {
        printf("Allocated blocks: ");
        for (i = start; i < start + fileSize; i++)
        {
            disk[i] = 1;
            printf("%d ", i);
        }
        printf("\n");
    }
}

void linked(int disk[], int n, int fileSize)
{
    int i, count = 0;

    printf("Allocated blocks: ");

    for (i = 0; i < n && count < fileSize; i++)
    {
        if (disk[i] == 0)
        {
            disk[i] = 1;
            printf("%d ", i);
            count++;
        }
    }

    if (count < fileSize)
        printf("\nAllocation failed. Not enough free blocks.\n");
    else
        printf("\n");
}

void indexed(int disk[], int n, int fileSize)
{
    int i, count = 0, indexBlock = -1;

    /* Find an index block */
    for (i = 0; i < n; i++)
    {
        if (disk[i] == 0)
        {
            indexBlock = i;
            disk[i] = 1;
            break;
        }
    }

    if (indexBlock == -1)
    {
        printf("Allocation failed. No index block available.\n");
        return;
    }

    printf("Index block: %d\n", indexBlock);
    printf("Allocated data blocks: ");

    for (i = 0; i < n && count < fileSize; i++)
    {
        if (disk[i] == 0)
        {
            disk[i] = 1;
            printf("%d ", i);
            count++;
        }
    }

    if (count < fileSize)
    {
        printf("\nAllocation failed. Not enough free blocks.\n");
    }
    else
    {
        printf("\n");
    }
}

int main()
{
    int disk[MAX];
    int n, fileSize, method;
    int i;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);

    printf("Enter disk status (0 = free, 1 = allocated):\n");

    for (i = 0; i < n; i++)
        scanf("%d", &disk[i]);

    printf("Enter file size in blocks: ");
    scanf("%d", &fileSize);

    printf("\n1. Contiguous\n");
    printf("2. Linked\n");
    printf("3. Indexed\n");
    printf("Enter allocation method: ");
    scanf("%d", &method);

    if (fileSize <= 0 || fileSize > n)
    {
        printf("Invalid file size.\n");
        return 0;
    }

    switch (method)
    {
        case 1:
            contiguous(disk, n, fileSize);
            break;

        case 2:
            linked(disk, n, fileSize);
            break;

        case 3:
            indexed(disk, n, fileSize);
            break;

        default:
            printf("Invalid method.\n");
    }

    return 0;
}
