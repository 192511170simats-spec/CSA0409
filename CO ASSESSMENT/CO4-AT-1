 printf("\nLOOK: %d ",x);
 for(i=0;i<n;i++)
  if(a[i]>=h){t+=a[i]-x;x=a[i];printf("%d ",x);}
 for(i=n-1;i>=0;i--)
  if(a[i]<h){t+=x-a[i];x=a[i];printf("%d ",x);}
