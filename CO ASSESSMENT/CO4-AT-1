#include <stdio.h>

int main() {
    int d[50]={0}, n, f, ch, i, c=0;

    printf("Disk blocks: ");
    scanf("%d",&n);

    printf("File size: ");
    scanf("%d",&f);

    printf("1.Contiguous  2.Linked  3.Indexed\n");
    scanf("%d",&ch);

    if(ch==1) {
        for(i=0;i<n;i++) {
            if(d[i]==0) c++;
            else c=0;

            if(c==f) break;
        }

        if(c<f)
            printf("Allocation failed");
        else {
            printf("Blocks: ");
            for(i=i-f+1;i<=i;i++)
                printf("%d ",i);
        }
    }

    else if(ch==2) {
        printf("Blocks: ");
        for(i=0;i<n && f;i++)
            if(d[i]==0) {
                printf("%d ",i);
                f--;
            }
    }

    else if(ch==3) {
        printf("Index block: 0\nBlocks: ");
        for(i=1;i<n && f;i++) {
            printf("%d ",i);
            f--;
        }
    }

    else
        printf("Invalid choice");

    return 0;
}
