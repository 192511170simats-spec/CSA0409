 #include <stdio.h>

#define MAX 100

void allocateBlocks(int bitmap[], int n, int required)
{
    int i, count = 0;

    for (i = 0; i < n && count < required; i++)
    {
        if (bitmap[i] == 0)
        {
            bitmap[i] = 1;
            count++;
        }
    }

    if (count == required)
        printf("Allocation successful.\n");
    else
    {
        printf("Allocation failed. Not enough free blocks.\n");

        /* Undo partial allocation */
        count = 0;

        for (i = 0; i < n && count < required; i++)
        {
            if (bitmap[i] == 1)
            {
                bitmap[i] = 0;
                count++;
            }
        }
    }
}

void deallocateBlock(int bitmap[], int n, int block)
{
    if (block < 0 || block >= n)
    {
        printf("Invalid block number.\n");
        return;
    }

    if (bitmap[block] == 1)
    {
        bitmap[block] = 0;
        printf("Block %d deallocated successfully.\n", block);
    }
    else
    {
        printf("Block %d is already free.\n", block);
    }
}

void displayBitmap(int bitmap[], int n)
{
    int i;

    printf("Bitmap: ");

    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    printf("\n");
}

int main()
