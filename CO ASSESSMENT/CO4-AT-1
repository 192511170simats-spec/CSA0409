{
    int i, total = 0, current = head;

    printf("FCFS Sequence: %d ", head);

    for (i = 0; i < n; i++)
    {
        total += abs(current - blocks[i]);
        current = blocks[i];
        printf("-> %d ", current);
    }

    printf("\nTotal Seek Time = %d\n", total);

