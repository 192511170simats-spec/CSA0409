        current = diskSize - 1;
        printf("-> %d ", current);

        for (i = n - 1; i >= 0; i--)
        {
            if (a[i] > head)
            {
                total += abs(current - a[i]);
                current = a[i];
                printf("-> %d ", current);
            }
        }
    }

    printf("\nC-SCAN Total Head Movement = %d\n", total);
}

