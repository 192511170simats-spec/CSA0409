 for(i=0;i<n;i++)scanf("%d",&a[i]);
 printf("Head Disk: ");scanf("%d%d",&h,&d);

 for(i=0;i<n;i++)
  for(j=i+1;j<n;j++)
   if(a[i]>a[j])
   {int q=a[i];a[i]=a[j];a[j]=q;}

 x=h;t=0;
 printf("C-SCAN: %d ",x);
 for(i=0;i<n;i++)
  if(a[i]>=h){t+=a[i]-x;x=a[i];printf("%d ",x);}
 t+=d-1-x+d-1;x=0;
