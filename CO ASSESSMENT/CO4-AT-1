#include <stdio.h>
#include <stdlib.h>

#define MAX 100

void fcfs(int request[], int n, int head)
{
    int i, total = 0, current = head;

    printf("\nFCFS Seek Sequence: %d ", head);

    for (i = 0; i < n; i++)
    {
        total += abs(current - request[i]);
        current = request[i];
        printf("-> %d ", current);
    }

    printf("\nFCFS Total Seek Time = %d\n", total);
}

void sstf(int request[], int n, int head)
{
    int visited[MAX] = {0};
    int i, j, index, distance;
    int total = 0, current = head;

    printf("\nSSTF Seek Sequence: %d ", head);

    for (i = 0; i < n; i++)
    {
        index = -1;
        distance = 999999;

        for (j = 0; j < n; j++)
        {
            if (!visited[j])
            {
                if (abs(current - request[j]) < distance)
                {
                    distance = abs(current - request[j]);
                    index = j;
                }
            }
        }

        visited[index] = 1;
        total += distance;
        current = request[index];

        printf("-> %d ", current);
    }

    printf("\nSSTF Total Seek Time = %d\n", total);
}

void scan(int request[], int n, int head, int diskSize)
{
    int temp[MAX];
    int i, j, total = 0;
    int current = head;

    for (i = 0; i < n; i++)
        temp[i] = request[i];

    /* Sort requests */
    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (temp[j] > temp[j + 1])
            {
                int t = temp[j];
                temp[j] = temp[j + 1];
                temp[j + 1] = t;
            }
        }
    }

    printf("\nSCAN Seek Sequence: %d ", head);

    /* Move right */
    for (i = 0; i < n; i++)
    {
        if (temp[i] >= head)
        {
            total += abs(current - temp[i]);
            current = temp[i];
            printf("-> %d ", current);
        }
    }

    /* Move to end of disk */
    total += abs(current - (diskSize - 1));
    current = diskSize - 1;
    printf("-> %d ", current);

    /* Reverse direction */
    for (i = n - 1; i >= 0; i--)
    {
        if (temp[i] < head)
        {
            total += abs(current - temp[i]);
            current = temp[i];
            printf("-> %d ", current);
        }
    }

    printf("\nSCAN Total Seek Time = %d\n", total);
}

int main()
{
    int request[MAX];
    int n, head, diskSize;
    int i;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    fcfs(request, n, head);
    sstf(request, n, head);
    scan(request, n, head, diskSize);

    return 0;
}

